{
  "rewrites": [
    { "source": "/product-catalog/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/product-catalog/logos/:path*", "destination": "/logos/:path*" },
    { "source": "/product-catalog/favicon-greenpi.svg", "destination": "/favicon-greenpi.svg" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
