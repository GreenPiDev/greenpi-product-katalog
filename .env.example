# Sunucu tarafı — sadece Vercel Project Settings > Environment Variables içine girilir.
# Bu değerleri hiçbir zaman koda veya bu dosyaya gerçek değerleriyle yazma.
ADMIN_PASSWORD=
GH_ADMIN_TOKEN=

# İstemci tarafı — Vite build'e gömülür, bu yüzden gizli değildir.
VITE_CLOUDINARY_CLOUD_NAME=j2kzfrih
VITE_CLOUDINARY_UPLOAD_PRESET=greenpi-product-catalog

# Vercel'de bu değeri ortama göre farklı gir:
#   Production ortamı  -> production
#   Preview/Development -> development
# Görseller buna göre greenpi-product-katalog/<değer> klasörüne yüklenir.
VITE_CLOUDINARY_ENV=development
